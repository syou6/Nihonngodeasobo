{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/subscription/(.*)",
      "destination": "/",
      "permanent": false
    }
  ]
}
