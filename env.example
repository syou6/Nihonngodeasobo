# Supabase設定
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Firebase設定（プッシュ通知用）
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# AI (NVIDIA NIM) はサーバーサイド（Supabase Edge Function）で管理されます
# クライアント側の設定は不要です
# デプロイ時: supabase secrets set NVIDIA_API_KEY=your_key
# モデル変更（任意, 既定 qwen/qwen2.5-72b-instruct）: supabase secrets set NVIDIA_MODEL=...

# Stripe設定（オプション）
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Error monitoring (optional — leave empty to disable)
VITE_SENTRY_DSN=

# Analytics (optional — Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
