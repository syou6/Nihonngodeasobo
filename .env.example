# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI (NVIDIA NIM) はサーバーサイド（Supabase Edge Function）で管理されます
# クライアント側の設定は不要です
# デプロイ時: supabase secrets set NVIDIA_API_KEY=your_key
# モデル変更（任意, 既定 qwen/qwen2.5-72b-instruct）: supabase secrets set NVIDIA_MODEL=...


# Stripe (https://dashboard.stripe.com/test/apikeys)
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key
VITE_STRIPE_PREMIUM_PRICE_ID=your_stripe_monthly_price_id
# Annual plan ($59/yr). Without this the Annual card cannot start checkout.
VITE_STRIPE_ANNUAL_PRICE_ID=your_stripe_annual_price_id
# Optional one-time onboarding discount coupon
VITE_STRIPE_ONBOARDING_COUPON_ID=
# Error monitoring (optional)
VITE_SENTRY_DSN=

# Google Analytics 4 (optional)
VITE_GA_MEASUREMENT_ID=
